# ==================================================
# PPOB BOT ECOSYSTEM - ENVIRONMENT CONFIGURATION
# Copy to .env and fill in real credentials before running in production.
# Never commit .env or expose secrets to frontend/logs.
# ==================================================

# A. GENERAL
NODE_ENV=development
PORT=3000
SHOP_NAME=PulsaSync Store
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
APP_URL=http://localhost:3000

# B. DATABASE
DATABASE_PATH=data/database.sqlite

# C. DASHBOARD AUTHENTICATION & SECURITY
# Required for Dashboard Basic Auth and session signing
DASHBOARD_AUTH_USER=
DASHBOARD_AUTH_PASSWORD=
# Opsional: min 16 karakter; jika kosong akan otomatis diderivasi secara kriptografis oleh server
SESSION_SECRET=
OWNER_WHATSAPP_JID=
OWNER_TELEGRAM_ID=
# Opsional: username Telegram admin (tanpa @) agar tombol Hubungi Admin langsung membuka https://t.me/username
OWNER_TELEGRAM_USERNAME=

# D. PAYMENT GATEWAY MYZZSTORE (https://gateway.myzzstore.my.id)
# Cukup isi API Key & endpoint; sistem menggunakan polling (secret/merchantId/callbackSecret opsional)
PAYMENT_GATEWAY_BASE_URL=https://gateway.myzzstore.my.id
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_CALLBACK_SECRET=
PAYMENT_GATEWAY_TIMEOUT=30000
# Official MyZZStore endpoint paths
PAYMENT_GATEWAY_CREATE_PATH=/create-qris
PAYMENT_GATEWAY_STATUS_PATH=/check-payment
PAYMENT_GATEWAY_CANCEL_PATH=

# E. DIGIFLAZZ SUPPLIER API
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_TIMEOUT=30000
DIGIFLAZZ_PRICE_SYNC_CRON=0 */6 * * *
# Opsional: isi angka menit (5-1440) jika ingin auto-refresh produk berbasis interval tetap
DIGIFLAZZ_PRICE_SYNC_INTERVAL_MINUTES=
# Secret key webhook Digiflazz (menu Atur Koneksi -> API -> Webhook) untuk memverifikasi X-Hub-Signature
DIGIFLAZZ_WEBHOOK_SECRET=

# F. WHATSAPP BOT (@whiskeysockets/baileys)
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=data/whatsapp-session
# 1. Grup log event layanan admin
WHATSAPP_SERVICE_LOG_GROUP=
# 2. Grup log all transaksi admin
WHATSAPP_TRANSACTION_LOG_GROUP=
# 3. Grup log transaksi sukses admin (full tanpa sensor)
WHATSAPP_SUCCESS_LOG_GROUP=
# 4. Grup/channel testimoni member (disensor, hanya transaksi sukses)
WHATSAPP_TESTIMONY_GROUP=
WHATSAPP_RECONNECT_MIN_DELAY=3000
WHATSAPP_RECONNECT_MAX_DELAY=60000

# G. TELEGRAM BOT (Telegraf - Webhook Mode)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Opsional: username bot Telegram (tanpa @) untuk footer testimoni (otomatis terdeteksi jika bot Telegram aktif)
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=webhook
# Opsional: default otomatis memakai ${APP_URL}/api/telegram/webhook bila APP_URL sudah https://
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# 1. Grup/channel log event layanan admin
TELEGRAM_SERVICE_LOG_CHAT_ID=
# 2. Grup/channel log all transaksi admin
TELEGRAM_TRANSACTION_LOG_CHAT_ID=
# 3. Grup/channel log transaksi sukses admin (full tanpa sensor)
TELEGRAM_SUCCESS_LOG_CHAT_ID=
# 4. Grup/channel testimoni member (disensor, hanya transaksi sukses; contoh -100... atau @channel)
TELEGRAM_TESTIMONY_CHAT_ID=

# H. TRANSACTION ENGINE
INVOICE_EXPIRY_MINUTES=5
TRANSACTION_COOLDOWN_SECONDS=30
UNIQUE_CODE_MIN=1
UNIQUE_CODE_MAX=99

# I. ACCOUNT LINKING
ACCOUNT_LINK_CODE_EXPIRY_MINUTES=5
ACCOUNT_LINK_MAX_ATTEMPTS=5

# J. CENTRAL SCHEDULER
PAYMENT_POLL_INTERVAL_SECONDS=5
SUPPLIER_POLL_INTERVAL_SECONDS=30
RECONCILIATION_INTERVAL_SECONDS=60
NOTIFICATION_RETRY_INTERVAL_SECONDS=30

# K. BACKUP
BACKUP_ENABLED=true
BACKUP_CRON=0 0 * * *
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14

# L. RATE LIMITING & PROXY
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
TRUST_PROXY=false

# M. MAINTENANCE
MAINTENANCE_MODE=false
